    {
      "cell_type": "code",
      "source": [
        "# Agrupación temporal mensual\n",
        "serie_mensual = df.groupby(\"Año_Mes\").agg(\n",
        "    Ingresos_Millones=(\"Total_Millones\", \"sum\"),\n",
        "    Transacciones=(\"Total_Millones\", \"count\")\n",
        ").reset_index()\n",
        "\n",
        "serie_mensual[\"Periodo_Str\"] = serie_mensual[\"Año_Mes\"].astype(str)\n",
        "serie_mensual[\"Media_Movil_3M\"] = serie_mensual[\"Ingresos_Millones\"].rolling(window=3, min_periods=1).mean()\n",
        "\n",
        "plt.figure(figsize=(14, 5))\n",
        "plt.plot(serie_mensual[\"Periodo_Str\"], serie_mensual[\"Ingresos_Millones\"], marker=\"o\",\n",
        "         color=\"#1d3557\", linewidth=2.5, label=\"Ventas Mensuales (Millones COP)\")\n",
        "plt.plot(serie_mensual[\"Periodo_Str\"], serie_mensual[\"Media_Movil_3M\"], linestyle=\"--\",\n",
        "         color=\"#e63946\", linewidth=2, label=\"Tendencia Media Móvil (3 Meses)\")\n",
        "\n",
        "plt.title(\"Evolución Cronológica de Ventas y Tendencia (Enero 2025 - Junio 2026)\", pad=15)\n",
        "plt.xlabel(\"Mes de Operación\")\n",
        "plt.ylabel(\"Ingresos Totales (Millones COP)\")\n",
        "plt.xticks(rotation=45)\n",
        "plt.legend(frameon=True)\n",
        "plt.grid(True, linestyle=\"--\", alpha=0.5)\n",
        "\n",
        "# Señalización de picos históricos\n",
        "max_mes = serie_mensual.loc[serie_mensual[\"Ingresos_Millones\"].idxmax()]\n",
