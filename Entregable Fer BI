    {
      "cell_type": "code",
      "source": [
        "# Agregación para análisis de Pareto\n",
        "pareto_prod = df.groupby(\"Producto\").agg(\n",
        "    Ingresos_COP=(\"Total de la venta\", \"sum\"),\n",
        "    Transacciones=(\"Total de la venta\", \"count\"),\n",
        "    Unidades=(\"Unidades\", \"sum\")\n",
        ").sort_values(by=\"Ingresos_COP\", ascending=False)\n",
        "\n",
        "pareto_prod[\"Ingresos_Millones\"] = pareto_prod[\"Ingresos_COP\"] / 1e6\n",
        "pareto_prod[\"%_Relativo\"] = (pareto_prod[\"Ingresos_COP\"] / pareto_prod[\"Ingresos_COP\"].sum()) * 100\n",
        "pareto_prod[\"%_Acumulado\"] = pareto_prod[\"%_Relativo\"].cumsum()\n",
        "\n",
        "# Gráfico de Pareto\n",
        "fig, ax1 = plt.subplots(figsize=(12, 6))\n",
        "\n",
        "# Barras de ingresos absolutos\n",
        "color_barras = \"#1d3557\"\n",
        "ax1.bar(pareto_prod.index, pareto_prod[\"Ingresos_Millones\"], color=color_barras, width=0.55, label=\"Ingresos (COP Millones)\")\n",
        "ax1.set_ylabel(\"Ingresos Totales (Millones COP)\", color=color_barras, fontweight=\"bold\")\n",
        "ax1.set_ylim(0, pareto_prod[\"Ingresos_Millones\"].max() * 1.15)\n",
        "ax1.grid(axis=\"y\", linestyle=\"--\", alpha=0.5)\n",
        "\n",
        "# Etiquetas de datos sobre barras\n",
        "for i, val in enumerate(pareto_prod[\"Ingresos_Millones\"]):\n",
        "    ax1.text(i, val + 25, f\"${val:,.0f}M\\n({pareto_prod['%_Relativo'].iloc[i]:.1f}%)\",\n",
        "             ha=\"center\", va=\"bottom\", fontsize=9, fontweight=\"bold\")\n",
        "\n",
        "# Eje secundario para la curva acumulada\n",
        "ax2 = ax1.twinx()\n",
        "color_linea = \"#e63946\"\n",
        "ax2.plot(pareto_prod.index, pareto_prod[\"%_Acumulado\"], color=color_linea, marker=\"o\", linewidth=2.5, label=\"% Acumulado\")\n",
        "ax2.axhline(80, color=\"gray\", linestyle=\"--\", alpha=0.7, label=\"Umbral 80/20\")\n",
        "ax2.set_ylabel(\"Porcentaje Acumulado (%)\", color=color_linea, fontweight=\"bold\")\n",
        "ax2.set_ylim(0, 110)\n",
        "ax2.grid(False)\n",
        "\n",
        "plt.title(\"Curva de Pareto de Ingresos por Línea de Producto (Ley 80/20)\", pad=15)\n",
        "fig.tight_layout()\n",
        "plt.show()"
      ],
